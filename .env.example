# Database (Coolify managed PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fridayquiz?schema=public"

# NextAuth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="change-this-to-a-random-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Admin Email - first user or this email gets QUIZMASTER role
QUIZMASTER_EMAIL="admin@fridayquiz.com"

# Email (Brevo SMTP)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-brevo-username@smtp-brevo.com"
SMTP_PASS="your-brevo-smtp-key-here"
EMAIL_FROM="noreply@daveys.xyz"

# File Storage
UPLOAD_DIR="./uploads"